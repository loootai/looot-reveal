# looot key for real lookups and for the CLI without --dry-run. Create one in looot Settings > Agent tokens. Not needed for the demo.
LOOOT_TOKEN=
# Optional. Overrides the API base, default https://api.looot.ai
# LOOOT_API_URL=
# Optional. State file shared by the web UI and the CLI. Default data/reveal.json. --state on the CLI overrides it.
# REVEAL_DATA=
# Optional. Web UI config file, default reveal.config.json
# REVEAL_CONFIG=
# Optional. Set to 1 to run the web UI on sample data
# NEXT_PUBLIC_DEMO=
# Optional. Key for your own identity supplier, if you turn on person-level identification and its HTTP adapter.
# The variable name is set in reveal.config.json under personLevel.http.authEnv. This is the default name.
# REVEAL_PERSON_API_KEY=
