# looot key for real lookups and for the CLI without --dry-run. Create one in looot Settings > Agent tokens. Not needed for the demo.
LOOOT_TOKEN=
# Admin password for every page and API route except the public ones (snippet endpoint, opt-out, health). 12 characters or more.
# Required outside the demo. Without it the admin pages stay closed and /login shows a setup page.
REVEAL_ADMIN_PASSWORD=
# Alternative to the plain password: the output of `npm run hash-password -- 'your password'`. Wins if both are set.
# REVEAL_ADMIN_PASSWORD_HASH=
# Optional. Key that signs session cookies. Default: derived from the password, so a new password signs everyone out.
# REVEAL_SESSION_SECRET=
# Optional. Set to 0 only to test over plain http in production mode. Leave unset otherwise.
# REVEAL_COOKIE_SECURE=
# Optional. Overrides the API base, default https://api.looot.ai
# LOOOT_API_URL=
# Optional. State file shared by the web UI and the CLI. Default data/reveal.json. --state on the CLI overrides it.
# REVEAL_DATA=
# Optional. Web UI config file, default reveal.config.json
# REVEAL_CONFIG=
# Optional. Set to 1 to run the web UI on sample data
# NEXT_PUBLIC_DEMO=
# Optional. Key for your own identity supplier, if you turn on person-level identification and its HTTP adapter.
# The variable name is set in reveal.config.json under personLevel.http.authEnv. This is the default name.
# REVEAL_PERSON_API_KEY=
